{
  "name": "vscptt",
  "displayName": "vscptt",
  "description": "PTT BBS browser for VS Code",
  "version": "0.0.1",
  "publisher": "Evan",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vscptt.hello",
        "title": "vscptt: Hello"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "vsce package",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
